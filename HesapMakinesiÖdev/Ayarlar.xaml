<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HesapMakinesiÖdev.Ayarlar"
    Title="Ayarlar">

    <VerticalStackLayout
        Padding="20"
        Spacing="20">

        <Label
            Text="Hesap Makinesi Ayarları"
            FontSize="25"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Tema Seçimi"
            FontSize="20"
            FontAttributes="Bold" />

        <Button
            Text="Açık Tema"
            Clicked="AcikTema" />

        <Button
            Text="Koyu Tema"
            Clicked="KoyuTema" />

        <Button
            Text="Sistem Teması"
            Clicked="SistemTeması" />

    </VerticalStackLayout>

</ContentPage>