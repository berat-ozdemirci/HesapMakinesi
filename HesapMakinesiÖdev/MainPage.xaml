<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HesapMakinesiÖdev.MainPage"
             Style="{StaticResource HesapSayfaStili}">


    



    <Grid Padding="15" RowDefinitions="Auto,*,Auto">
        <Label 
            Grid.Row="0"
            Text="HESAP MAKİNESİ"
            Style="{StaticResource HesapBaslikStili}"/>

        <Label
            x:Name="SonucEkranı"
            Grid.Row="1"
            Text="0"
            
            Style="{StaticResource HesapSonucStili}" />

        <Grid
            
            Grid.Row="2"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnDefinitions="*,*,*,*"
            RowSpacing="5"
            ColumnSpacing="5">


            <Button Grid.Row="0" Grid.Column="0" Text="%" Clicked="YuzdeAl" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="0" Grid.Column="1" Text="CE" Clicked="CETiklandi" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="0" Grid.Column="2" Text="C" Clicked="CTiklandi" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="0" Grid.Column="3" Text="SİL" Clicked="Sil" Style="{StaticResource HesapSayiButonu}"/>

            <Button Grid.Row="1" Grid.Column="0" Text="1/x" Clicked="TersiniAl" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="1" Grid.Column="1" Text="x²" Clicked="KareAl" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="1" Grid.Column="2" Text="√x" Clicked="KarekokAl" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="1" Grid.Column="3" Text="÷" Clicked="IslemTikla" Style="{StaticResource HesapIslemButonu}"/>

            <Button Grid.Row="2" Grid.Column="0" Text="7" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="2" Grid.Column="3" Text="x" Clicked="IslemTikla" Style="{StaticResource HesapIslemButonu}"/>

            <Button Grid.Row="3" Grid.Column="0" Text="4" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="3" Grid.Column="1" Text="5" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="3" Grid.Column="2" Text="6" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="3" Grid.Column="3" Text="-" Clicked="IslemTikla" Style="{StaticResource HesapIslemButonu}"/>

            <Button Grid.Row="4" Grid.Column="0" Text="1" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="4" Grid.Column="1" Text="2" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="4" Grid.Column="2" Text="3" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="4" Grid.Column="3" Text="+" Clicked="IslemTikla" Style="{StaticResource HesapIslemButonu}"/>

            <Button Grid.Row="5" Grid.Column="0" Text="+/-" Clicked="IsaretDegis" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="5" Grid.Column="1" Text="0" Clicked="SayiTikla" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="5" Grid.Column="2" Text="," Clicked="VirgulTiklandi" Style="{StaticResource HesapSayiButonu}"/>
            <Button Grid.Row="5" Grid.Column="3" Text="=" Clicked="Esittir" Style="{StaticResource HesapIslemButonu}"/>

        </Grid>
    </Grid>
</ContentPage>
